# Crosby produktionsplan – webbhotell
RewriteEngine On
RewriteBase /projectplan/
RewriteRule ^api/(.*)$ api.php?path=$1 [QSA,L]

<Files "config.php">
  Require all denied
</Files>
<Files "schema.sql">
  Require all denied
</Files>
<FilesMatch "\.(example\.php|md)$">
  Require all denied
</FilesMatch>

# Sidan ska inte cachas av webbläsaren (annars syns inte uppdateringar förrän cachen rensas)
<IfModule mod_headers.c>
  <Files "index.html">
    Header set Cache-Control "no-cache, must-revalidate"
  </Files>
</IfModule>
