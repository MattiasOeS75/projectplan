# Crosby produktionsplan – webbhotell
RewriteEngine On
RewriteBase /projectplan/
RewriteRule ^api/(.*)$ api.php?path=$1 [QSA,L]

# Inloggning för hela sidan (API inkluderat). Användare/lösen i .htpasswd – se deploy/README.md.
# AuthUserFile måste vara den absoluta sökvägen till .htpasswd på servern (GET api/info visar katalogen).
AuthType Basic
AuthName "Crosby produktionsplan"
AuthUserFile /data/e/e/ee0f04f1-bc00-4ba0-adf2-4b60172dc598/cby.se/web/projectplan/.htpasswd
Require valid-user

<Files "config.php">
  Require all denied
</Files>
<Files "schema.sql">
  Require all denied
</Files>
<FilesMatch "\.(htpasswd|example\.php|md|json)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  <Files "index.html">
    Header set Cache-Control "no-cache, must-revalidate"
  </Files>
</IfModule>
