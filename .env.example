# Postgres (Websupport). Lämna PGHOST tomt för att köra mot en lokal JSON-fil (data/local.json).
PGHOST=db.r103.websupport.se
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=
PGSSL=true

# Monday.com – personlig API-token (monday.com → Avatar → Developers → My access tokens)
MONDAY_TOKEN=
# Kommaseparerade board-id:n att synka (hittas i boardets URL)
MONDAY_BOARDS=1071363420
# Resurser (standardvärden – ändra bara om boarden byts)
MONDAY_FRILANS=1083892887
MONDAY_FRANVARO=1071497633

PORT=3000
